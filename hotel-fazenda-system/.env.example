# Supabase — público (vai ao client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only (NUNCA expor ao client)
SUPABASE_SERVICE_ROLE_KEY=

# Postgres — Prisma usa pooler (6543) para queries e direct (5432) para migrations
# Transaction (pooler):  postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Session (direct):      postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed inicial (usado apenas por prisma/seed.ts; opcional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
